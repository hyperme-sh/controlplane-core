# Runtime bytes come from the qualified wheel, not a second source build.
FROM python:3.13-slim-bookworm@sha256:281d39ff02e3b389401586134ff9e6572954687822a58055ec07a60ded4e0b7f AS build
WORKDIR /build
RUN pip install --no-cache-dir uv==0.11.26
COPY requirements.txt ./
RUN uv venv /opt/storage && uv pip sync --python /opt/storage/bin/python --require-hashes requirements.txt
COPY private/ ./private/
COPY *.whl ./
RUN uv pip install --python /opt/storage/bin/python --no-deps private/*.whl ./*.whl && uv pip check --python /opt/storage/bin/python
COPY LICENSE NOTICE /build/legal/
COPY prepare_notices.py verify_notices.py /build/
COPY notice-supplements/ /build/notice-supplements/
RUN /opt/storage/bin/python /build/prepare_notices.py /build/legal/third-party /build/notice-supplements \
 && /opt/storage/bin/python /build/verify_notices.py /build/legal
COPY sources/ /build/sources/
COPY prepare_sources.py verify_base.py /build/
RUN /opt/storage/bin/python -I /build/prepare_sources.py verify /build/sources \
 && /opt/storage/bin/python -I /build/verify_base.py installed /build/sources/base-image.json /build/sources
COPY debian-sources/ /build/debian-sources/
COPY prepare_debian_sources.py /build/
RUN /opt/storage/bin/python -I /build/prepare_debian_sources.py verify /build/debian-sources
RUN /opt/storage/bin/python -I -c "from api.storage_app import app; assert app.routes"

FROM python:3.13-slim-bookworm@sha256:281d39ff02e3b389401586134ff9e6572954687822a58055ec07a60ded4e0b7f
COPY --from=build /opt/storage /opt/storage
COPY storage-schema/ /opt/storage-schema/
COPY --from=build /build/legal /usr/share/doc/controlplane-core
COPY --from=build /build/sources /usr/share/doc/controlplane-core/sources
COPY --from=build /build/debian-sources /usr/share/doc/controlplane-core/debian-sources
ENV PATH=/opt/storage/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ARG GIT_SHA
ARG WHEEL_SHA256
LABEL org.opencontainers.image.revision=${GIT_SHA} sh.hyperme.qualified-wheel-sha256=${WHEEL_SHA256}
ENV GIT_SHA=${GIT_SHA} SERVICE_NAME=tenant-storage
USER 65532:65532
EXPOSE 8000
CMD ["/opt/storage/bin/python", "-I", "-m", "uvicorn", "api.storage_app:app", "--host", "0.0.0.0", "--port", "8000"]
